# Copy to .env locally — never commit real keys
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Merchant TrueMoney phone that receives angpao (digits only, e.g. 0812345678)
TRUEWALLET_PHONE=
# Optional admin probe only — user heart runs require each caller’s own proxy.
HEART_PROXY_URL=
# Heart run timeout in seconds (default 600, max 1800). One run is a single
# synchronous HTTP request, so keep this under what the browser and any proxy
# in front of the API will hold open.
HEART_JOB_TIMEOUT_SEC=
