# Copy to .env locally — never commit real keys
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Merchant TrueMoney phone that receives angpao (digits only, e.g. 0812345678)
TRUEWALLET_PHONE=
# Rotating proxy for Heart farm guest creation, e.g. http://user:pass@host:port/
# The game rate-limits guest signups per source IP (~6), so heart farm stays
# disabled until this is set. Used for guest creation only — the user's own
# account never goes through it.
#
# The proxy must accept username/password auth from ANY source IP. Providers
# that default to IP-allowlist auth (Webshare calls it IP Authorization) reject
# with "403 proxy_ip_not_allowed", and a free Render instance has no static
# outbound IP to add to such a list.
HEART_PROXY_URL=
# Heart run timeout in seconds (default 600, max 1800). One run is a single
# synchronous HTTP request, so keep this under what the browser and any proxy
# in front of the API will hold open.
HEART_JOB_TIMEOUT_SEC=
